{
  "name": "cube-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:check": "tsgo -b --watch --noEmit",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fmt": "pnpm format",
    "lint": "oxlint . && tsx scripts/lint.ts",
    "lint:fix": "oxlint --fix . && tsx scripts/lint.ts --fix",
    "typecheck": "tsgo -b --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check",
    "fix": "pnpm run lint:fix && pnpm run typecheck && pnpm run format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "new-page": "tsx scripts/new-page.ts",
    "gen:api": "just -f ../justfile run openapi -o openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts && oxfmt src/api/schema.d.ts",
    "verify:shadcn": "node scripts/verify-shadcn.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.89.0",
    "shadcn": "^4.22.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
