{{/* 追加到 {domain}_handler.go 文件尾部：端点的 Input/Output 类型与 handler 方法 */}}
{{/* 坑：动作紧邻 `{` 时须留一个空格，format.Source 会收掉；直接写三连 `{` 模板解析会失败 */}}

/**
 * {{.upperMethod}} {{.route}}
 */

type {{.resultType}} struct {
	// TODO: 输出字段，如 Result string `json:"result"`
}

{{- if eq .method "post"}}
func ({{.recv}} *{{.handlerType}}) {{.handlerMethod}}(input WithBody[struct {
	// TODO: 请求体字段挂在 Body 里，如 Name string `json:"name"`
}]) (*{{.resultType}}, error) {
	// TODO: 业务逻辑（可调 {{.recv}}.{{.domain}}Service）
	return &{{.resultType}}{}, nil
}
{{- else}}
func ({{.recv}} *{{.handlerType}}) {{.handlerMethod}}(input struct {}) (*{{.resultType}}, error) {
	// TODO: 业务逻辑（可调 {{.recv}}.{{.domain}}Service）
	return &{{.resultType}}{}, nil
}
{{- end}}
